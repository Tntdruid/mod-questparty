[worldserver]

# QuestParty.Enable
#     Description: Lets grouped players loot their own copy of quest items from the same game object.
#     Default:     1 - (Enabled)
#                  0 - (Disabled)
QuestParty.Enable = 1

# QuestParty.Debug
#     Description: Writes detailed quest loot information to the "module" log
#                  whenever a grouped player opens or loots a game object.
#     Default:     0 - (Disabled)
#                  1 - (Enabled)
QuestParty.Debug = 0
